# Downloadify does NOT require a Spotify login or API key to work out of the
# box -- by default it reads playlists straight off Spotify's public embed
# page (no credentials of any kind), capped at the first ~100 tracks.
#
# Setting the two values below is OPTIONAL. If set, Downloadify uses them
# ONLY to fetch the tracks past that 100-track cap via the official Spotify
# Web API. Free to create, no login required for anyone using the app --
# just for you, once, as the developer:
#   1. https://developer.spotify.com/dashboard -> Create app
#   2. Any name/description; Redirect URI can be http://127.0.0.1:8080
#   3. Check "Web API", agree to terms, Save
#   4. Open the app -> Settings -> copy Client ID and Client Secret below
#
# IMPORTANT if you're publishing this project: put your real values in a
# file named `.env` (copy this file to `.env`, not the other way around).
# `.env` is already listed in .gitignore, so it will never be committed --
# keep it that way, and never paste real values into this .env.example file,
# the README, or a public issue/commit. This key is meant to stay on your
# machine only; anyone else running Downloadify should create their own free
# key the same way.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: only set this if yt-dlp reports "ffprobe and ffmpeg not found"
# even though you've installed ffmpeg. This is usually because the terminal/
# VS Code was opened before ffmpeg was installed and hasn't picked up the
# updated PATH yet -- restarting it is the real fix. If that's inconvenient
# right now, point this straight at the folder containing ffmpeg.exe /
# ffprobe.exe instead (e.g. wherever `winget install Gyan.FFmpeg` put it, or
# C:\ffmpeg\bin if you installed it manually). Leave blank once ffmpeg works
# on PATH normally.
FFMPEG_LOCATION=
