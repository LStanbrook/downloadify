{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Downloadify: Desktop GUI",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--mode", "gui"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Downloadify: Web App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--mode", "web"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
