/* Downloadify desktop theme -- palette and type treatment kept in exact
   sync with the website's CSS custom properties (see :root in
   downloadify/web/static/index.html):
     ink #0d1210        surface #141a16      surface-high #1c2620
     signal #1db954      paper #eef2ee        mist #8fa398
     line #24302a         danger #e2634f
   Small labels (field labels, status line, checkbox) use the site's mono
   "kicker" font (Cascadia Code/Consolas) to match its uppercase-mono-label
   treatment; Qt Style Sheets don't support text-transform, so the matching
   uppercase text itself is set in main_window.py rather than here.
*/

QWidget {
    background-color: #0d1210;
    color: #eef2ee;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 12.5pt;
}

QLabel#HeaderTitle {
    color: #eef2ee;
    font-size: 32pt;
    font-weight: 800;
}

QLabel#HeaderSubtitle {
    color: #8fa398;
    font-size: 13pt;
}

QFrame#Card {
    background-color: #141a16;
    border: 1px solid #24302a;
    border-radius: 6px;
}

QLabel#FieldLabel {
    color: #8fa398;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 9.5pt;
    font-weight: 600;
}

QLineEdit {
    background-color: #0d1210;
    border: 1px solid #24302a;
    border-radius: 4px;
    padding: 14px 16px;
    font-size: 12.5pt;
    color: #eef2ee;
    selection-background-color: #1db954;
    selection-color: #04240f;
}

QLineEdit:focus {
    border: 1px solid #1db954;
}

QLineEdit:disabled {
    color: #55655d;
}

QPushButton {
    border-radius: 3px;
    padding: 18px 36px;
    font-weight: 600;
    font-size: 13.5pt;
    border: none;
}

QPushButton#downloadButton {
    background-color: #1db954;
    color: #04240f;
}

QPushButton#downloadButton:hover:!disabled {
    background-color: #22d461;
}

QPushButton#downloadButton:pressed:!disabled {
    background-color: #12793a;
}

QPushButton#downloadButton:disabled {
    background-color: #1c2620;
    color: #4c5c53;
}

QPushButton#cancelButton {
    background-color: transparent;
    border: 1px solid #e2634f;
    color: #e2634f;
}

QPushButton#cancelButton:hover:!disabled {
    background-color: rgba(226, 99, 79, 0.12);
}

QPushButton#cancelButton:disabled {
    border: 1px solid #3a2c28;
    color: #5c4a45;
}

QPushButton#browseButton {
    background-color: #1c2620;
    color: #eef2ee;
    border: 1px solid #24302a;
    font-size: 11pt;
    font-weight: 600;
    padding: 10px 18px;
}

QPushButton#browseButton:hover:!disabled {
    border: 1px solid #8fa398;
}

QPushButton#browseButton:disabled {
    color: #55655d;
}

QProgressBar {
    background-color: #0d1210;
    border: 1px solid #24302a;
    border-radius: 16px;
    max-height: 44px;
    min-height: 44px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #1db954;
    border-radius: 15px;
}

QLabel#StatusLabel {
    color: #8fa398;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11pt;
    font-weight: 600;
}

QCheckBox {
    color: #8fa398;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 10.5pt;
    font-weight: 600;
    spacing: 10px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    border: 1px solid #24302a;
    background-color: #0d1210;
}

QCheckBox::indicator:hover {
    border: 1px solid #1db954;
}

QCheckBox::indicator:checked {
    background-color: #1db954;
    border: 1px solid #1db954;
}

QLabel#LogHeader {
    color: #eef2ee;
    font-size: 15pt;
    font-weight: 700;
}

QPlainTextEdit#LogView {
    background-color: #090c0a;
    border: 1px solid #24302a;
    border-radius: 6px;
    padding: 16px;
    font-family: "Cascadia Code", "Consolas", monospace;
    font-size: 11pt;
    color: #b8c4bd;
}

QSplitter::handle {
    background-color: transparent;
}

QSplitter::handle:vertical {
    height: 12px;
}

QScrollBar:vertical {
    background: transparent;
    width: 11px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #24302a;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #34443c;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QMessageBox {
    background-color: #141a16;
}
